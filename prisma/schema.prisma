// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  emailVerified     Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  password          String
  firstName         String
  lastName          String
  businesses        Business[]
  passwordToken     PasswordResetToken?
  profilePicture    String?
  activeBusinessId  String?                 @unique
  activeBusiness    Business?               @relation("UserActiveBusiness", fields: [activeBusinessId], references: [id])
  emailVerification EmailVerificationToken?
  notes             Notes[]                 @relation("UserNotes")
  notesUpdated      Notes[]                 @relation("NotesUpdated")

  linkedEmailAccount LinkedEmailAccount?
  linkedEmail        Boolean             @default(false)
  CampaignCreatedBy  Campaign[]          @relation("CampaignCreatedBy")
  CampaignUpdatedBy  Campaign[]          @relation("CampaignUpdatedBy")
  subscriptions      UserSubscription[]
  payments           Payment[]
}

model Business {
  id            String        @id @default(cuid())
  businessName  String
  location      String
  about         String
  createdAt     DateTime      @default(now())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  website       Website?      @relation("BusinessToWebsite")
  form          Form?         @relation("formToBusiness")
  invoice       Invoice[]     @relation("BusinessToInvoice")
  Customer      Customer[]
  socialMedia   SocialMedia[]
  businessEmail String?

  addressLineOne String?
  addressLineTwo String?
  country        String?
  state          String?
  city           String?
  postalCode     String?
  activeForUser  User?      @relation("UserActiveBusiness") // reverse of activeBusiness
  notes          Notes[]    @relation("BusinessNotes")
  Campaign       Campaign[]
}

model Website {
  id             String     @id @default(cuid())
  name           String?
  footer         String?
  header         String?
  favicon        String?
  description    String?
  content        String?
  theme          String?
  dateCreated    DateTime   @default(now())
  page           Page[]
  url            String     @unique()
  homePage       String     @default("/")
  businessId     String     @unique
  published      Boolean    @default(false)
  urlVisits      Int        @default(0)
  createdAt      DateTime   @default(now())
  analytics      Analytics? @relation("analyticsToWebsite")
  lastModified   DateTime   @updatedAt()
  business       Business   @relation(fields: [businessId], references: [id], name: "BusinessToWebsite", onDelete: Cascade)
  instagramToken String?
  // socialMedia   SocialMedia[]
}

model Page {
  id          String   @id @default(cuid())
  slug        String
  title       String?
  websiteId   String
  description String?
  label       String?
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  content     String?
  createdAt   DateTime @default(now())
  views       Int      @default(0)
  img         String?

  @@unique([slug, websiteId])
}

model Analytics {
  id               String             @id @unique @default(cuid())
  // visitsByBrowser  String[]
  websiteId        String             @unique
  urlVisits        Int                @default(0)
  website          Website            @relation(fields: [websiteId], references: [id], name: "analyticsToWebsite", onDelete: Cascade)
  visitsByLocation VisitsByLocation[] @relation(name: "visitedByLocation")
  visitsByBrowser  VisitsByBrowser[]  @relation(name: "visitedByBrowser")
}

model Form {
  id          String       @id @unique @default(cuid())
  title       String
  description String?
  fields      Field[]
  submissions Submission[]
  businessId  String       @unique
  createdAt   DateTime     @default(now())
  business    Business     @relation(fields: [businessId], references: [id], name: "formToBusiness", onDelete: Cascade)
}

model Field {
  id           String     @id @unique @default(cuid())
  form         Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId       String
  label        String
  type         FieldType
  placeholder  String     @default("")
  displayField Boolean    @default(true)
  required     Boolean    @default(false)
  options      String[]
  responses    Response[]
}

enum FieldType {
  text
  number
  date
  dropdown
  checkbox
  email
  textarea
}

model Submission {
  id          Int        @id @default(autoincrement())
  form        Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId      String
  responses   Response[]
  submittedAt DateTime   @default(now())

  customerId      String?
  customer        Customer? @relation("CustomerSubmissions", fields: [customerId], references: [id])
  createdCustomer Customer? @relation("CreatedCustomer")
}

model Response {
  id           Int        @id @default(autoincrement())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId Int
  field        Field      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId      String
  value        String
}

model Customer {
  id         String   @id @default(cuid())
  fullName   String
  newMessage Boolean  @default(false)
  email      String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdFromId Int?        @unique
  createdFrom   Submission? @relation("CreatedCustomer", fields: [createdFromId], references: [id])

  submissions Submission[] @relation("CustomerSubmissions")
  notes       Notes[]      @relation("CustomerNotes")
  invoices    Invoice[]    @relation("CustomerInvoices")
  campaigns   Campaign[]   @relation("CampaignRecipients")
}

model VisitsByBrowser {
  id          String    @id @default(cuid())
  browser     String
  count       Int       @default(1)
  analyticsId String
  analytics   Analytics @relation(fields: [analyticsId], references: [websiteId], name: "visitedByBrowser")

  @@unique([browser, analyticsId])
}

model VisitsByLocation {
  id          String    @id @default(cuid())
  country     String
  region      String
  timezone    String
  city        String
  count       Int       @default(1)
  analyticsId String
  analytics   Analytics @relation(fields: [analyticsId], references: [websiteId], name: "visitedByLocation")

  @@unique([country, region, city, timezone, analyticsId])
}

model Invoice {
  id          String        @unique @default(cuid())
  invoiceNo   String        @unique @default(cuid())
  createdAt   DateTime      @default(now())
  dueDate     DateTime
  vat         String
  charges     String
  status      Int           @default(0)
  invoiceItem InvoiceItem[]
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], name: "BusinessToInvoice", onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, name: "CustomerInvoices")
}

model InvoiceItem {
  id        String  @id @unique @default(cuid())
  itemName  String
  quantity  Int
  amount    Int
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
}

model PasswordResetToken {
  token     String   @id
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model EmailVerificationToken {
  token  String @id
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialMedia {
  id         String   @id @default(cuid())
  platform   String
  url        String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, businessId])
}

model Notes {
  id            String   @id @default(cuid())
  title         String
  content       String?
  createdAt     DateTime @default(now())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, name: "CustomerNotes")
  updatedAt     DateTime @updatedAt
  createdById   String? // Optional field to track who created the note
  createdByUser User?    @relation(fields: [createdById], references: [id], onDelete: SetNull, name: "UserNotes")
  updatedById   String? // Optional field to track who last updated the note
  updatedByUser User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull, "NotesUpdated")
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade, name: "BusinessNotes")
}

// social media

model LinkedEmailAccount {
  id           String    @id @default(uuid())
  userId       String    @unique
  accessToken  String
  provider     Providers
  refreshToken String
  expiryDate   DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Providers {
  GOOGLE
  MICROSOFT
  // CUSTOM
}

model Campaign {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Cascade, name: "CampaignCreatedBy")
  updatedById String?
  updatedBy   User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull, name: "CampaignUpdatedBy")
  title       String
  description String     @default("")
  body        String     @default("")
  recipients  Customer[] @relation("CampaignRecipients")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scheduledAt DateTime? @default(now())
  sentAt      DateTime?

  status CampaignStatus @default(DRAFT)
  jobId  String?        @unique

  failedCount    Int @default(0)
  deliveredCount Int @default(0)

  failedRecipients String[] @default([])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Subscription {
  id                String             @id @default(uuid())
  name              String
  price             Float
  durationMonths    Int
  userSubscriptions UserSubscription[]
}

model UserSubscription {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  startDate      DateTime
  endDate        DateTime
  status         String
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  reference String   @unique
  status    String // 'pending', 'success', 'failed'
  createdAt DateTime @default(now())
  metadata  Json?
}
