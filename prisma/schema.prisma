// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  password      String
  firstName     String
  lastName      String
  businesses    Business[]
}

model Business {
  id           String     @id @default(cuid())
  businessName String
  location     String
  about        String
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  website      Website?   @relation("BusinessToWebsite")
  form         Form[]
  // websiteId    String? @unique
  Customer     Customer[]
}

model Website {
  id          String   @id @default(cuid())
  name        String?
  footer      String?
  header      String?
  favicon     String?
  description String?
  content     String?
  page        Page[]
  url         String   @unique()
  homePage    String   @default("/")
  businessId  String   @unique
  published   Boolean  @default(false)
  urlVisits   Int      @default(0)
  business    Business @relation(fields: [businessId], references: [id], name: "BusinessToWebsite", onDelete: Cascade)
}

model Page {
  id          String  @id @default(cuid())
  slug        String
  title       String?
  websiteId   String
  description String?
  label       String?
  website     Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  content     String?
  views       Int     @default(0)

  @@unique([slug, websiteId])
}

model Form {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  fields      Field[]
  submissions Submission[]
  businessId  String
  createdAt   DateTime     @default(now())
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Field {
  id        Int        @id @default(autoincrement())
  form      Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    Int
  label     String
  type      String
  options   String[]
  required  Boolean    @default(false)
  responses Response[]
}

model Submission {
  id          Int        @id @default(autoincrement())
  form        Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId      Int
  responses   Response[]
  submittedAt DateTime   @default(now())

  customerId String?
  customer   Customer? @relation("CustomerSubmissions", fields: [customerId], references: [id])
  createdCustomer Customer? @relation("CreatedCustomer")
}

model Response {
  id           Int        @id @default(autoincrement())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId Int
  field        Field      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fieldId      Int
  value        String
}

model Customer {
  id         String   @id @default(cuid())
  fullName   String
  newMessage Boolean  @default(false)
  email      String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdFromId Int?        @unique
  createdFrom   Submission? @relation("CreatedCustomer", fields: [createdFromId], references: [id])

  submissions Submission[] @relation("CustomerSubmissions")
}
